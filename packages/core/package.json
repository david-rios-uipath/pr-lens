{
  "name": "@pr-lens/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./progress": {
      "types": "./dist/progress.d.ts",
      "default": "./dist/progress.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts src/progress.ts --format esm --dts --sourcemap",
    "dev": "tsup src/index.ts src/progress.ts --format esm --dts --sourcemap --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": { "zod": "^3.23.8" }
}
